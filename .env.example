# Plantilla de variables de entorno para docker-compose.
# Copia este archivo como .env y reemplaza los valores placeholder.
#
# Cadena de conexion del backend a la PostgreSQL del host (host.docker.internal:5432).
# host.docker.internal = el servicio PostgreSQL instalado en el host de Windows.
# Reemplaza <usuario>, <password> y <basedatos> por los de tu PostgreSQL de Windows.
DATABASE_URL=postgresql+psycopg://<usuario>:<password>@host.docker.internal:5432/<basedatos>

# URL del backend que consume el frontend (puerto publicado en el host).
VITE_API_URL=http://localhost:8000/api
